{
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/turfs/[a-fA-F0-9]{24}/?$", "dest": "/index.html", "methods": ["GET", "HEAD"] },
    { "src": "^/(?:(?:login|signup|complete-profile|(?:owner|turfManeger)(?:/turfs/(?:new|[a-fA-F0-9]{24}(?:/setup)?))?)/?)?$", "dest": "/index.html", "methods": ["GET", "HEAD"] },
    { "src": "/.*", "dest": "/index.html", "status": 404, "methods": ["GET", "HEAD"] }
  ]
}
